generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         Int                @id @default(autoincrement())
  nombre     String
  email      String             @unique
  password   String
  telefono   String?
  rol        Rol                @default(CLIENTE)
  createdAt  DateTime           @default(now())
  citas      Cita[]
  membresias UsuarioMembresia[]
  ventasCobradas Venta[]
}

model Barbero {
  id           Int      @id @default(autoincrement())
  nombre       String
  especialidad String
  foto         String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  pin          String?
  descripcion  String?
  citas        Cita[]
  ventas       Venta[]
}

model Servicio {
  id          Int                  @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  duracion    Int
  activo      Boolean              @default(true)
  imagen      String?
  citas       CitaServicio[]
  componentes ServicioComponente[]
}

model ComponenteServicio {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  servicios ServicioComponente[]

  reglasOrigen       ReglaComponente[] @relation("ComponenteReglas")
  reglasRelacionadas ReglaComponente[] @relation("RelacionadoReglas")
}

model ServicioComponente {
  servicioId   Int
  componenteId Int

  servicio   Servicio           @relation(fields: [servicioId], references: [id])
  componente ComponenteServicio @relation(fields: [componenteId], references: [id])

  @@id([servicioId, componenteId])
}

enum TipoReglaComponente {
  PERMITIR
  PROHIBIR
}

model ReglaComponente {
  id            Int                 @id @default(autoincrement())
  componenteId  Int
  relacionadoId Int
  tipo          TipoReglaComponente
  activo        Boolean             @default(true)
  createdAt     DateTime            @default(now())

  componente  ComponenteServicio @relation("ComponenteReglas", fields: [componenteId], references: [id])
  relacionado ComponenteServicio @relation("RelacionadoReglas", fields: [relacionadoId], references: [id])

  @@unique([componenteId, relacionadoId])
}

model EstiloCorte {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  imagen      String?
  categoria   String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Cita {
  id        Int            @id @default(autoincrement())
  fecha     DateTime
  hora      String
  estado    EstadoCita     @default(PENDIENTE)
  nota      String?
  createdAt DateTime       @default(now())
  usuarioId Int
  barberoId Int
  barbero   Barbero        @relation(fields: [barberoId], references: [id])
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  servicios CitaServicio[]
  venta     Venta?
}

model CitaServicio {
  citaId     Int
  servicioId Int
  cita       Cita     @relation(fields: [citaId], references: [id])
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  @@id([citaId, servicioId])
}

enum Rol {
  ADMIN
  RECEPCION
  PRODUCTOS
  CLIENTE

}

model Venta {
  id                Int             @id @default(autoincrement())
  citaId            Int?            @unique
  cita              Cita?           @relation(fields: [citaId], references: [id])
  barberoId         Int?
  barbero           Barbero?        @relation(fields: [barberoId], references: [id])
  itemsExtra        VentaExtra[]
  productos         VentaProducto[]
  subtotalServicios Float           @default(0)
  subtotalExtras    Float           @default(0)
  subtotalProductos Float           @default(0)
  total             Float
  metodoPago        MetodoPago?
  cobrado           Boolean         @default(false)
  cobradoPorId      Int?
  cobradoPor        Usuario?        @relation(fields: [cobradoPorId], references: [id])
  fechaCobro        DateTime?
  createdAt         DateTime        @default(now())
}

model VentaExtra {
  id          Int    @id @default(autoincrement())
  ventaId     Int
  venta       Venta  @relation(fields: [ventaId], references: [id])
  descripcion String
  precio      Float
}

model VentaProducto {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  venta      Venta    @relation(fields: [ventaId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  precioUnit Float
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}


model ImagenCarrusel {
  id          Int      @id @default(autoincrement())
  url         String
  nombre      String
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float
  imagen      String?
  categoria   String?
  badge       String?
  stock       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  ventas      VentaProducto[]
}

model Membresia {
  id              Int                @id @default(autoincrement())
  nombre          String
  precio          Float
  cortesIncluidos Int
  descripcion     String?
  beneficios      String?
  descuento       Int                @default(0)
  activo          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  usuarios        UsuarioMembresia[]
}

model UsuarioMembresia {
  id           Int             @id @default(autoincrement())
  usuarioId    Int
  membresiaId  Int
  fechaInicio  DateTime        @default(now())
  fechaFin     DateTime
  cortesUsados Int             @default(0)
  estado       EstadoMembresia @default(ACTIVA)
  createdAt    DateTime        @default(now())
  membresia    Membresia       @relation(fields: [membresiaId], references: [id])
  usuario      Usuario         @relation(fields: [usuarioId], references: [id])
}



enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum EstadoMembresia {
  ACTIVA
  CANCELADA
  VENCIDA
  AGOTADA
}
