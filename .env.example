# ── Base de datos ─────────────────────────────────────────────────────────────
# Cadena de conexión a PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/lafama_db"

# ── Autenticación ─────────────────────────────────────────────────────────────
# Clave secreta para firmar JWTs (mínimo 16 caracteres, usa un valor aleatorio)
JWT_SECRET="cambia_esto_por_un_secreto_seguro_min16"

# Clave secreta para las sesiones de Express
SESSION_SECRET="cambia_esto_por_otro_secreto_seguro_min16"

# ── Google OAuth 2.0 (opcional) ───────────────────────────────────────────────
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://tu-dominio.com/api/auth/google/callback"
FRONTEND_URL="https://tu-dominio.com"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origen permitido para el frontend (sin barra final)
CORS_ORIGIN="http://localhost:5173"

# ── WhatsApp / Meta Cloud API ─────────────────────────────────────────────────
# Se configuran en developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
GRAPH_API_VERSION="v23.0"
# Secreto de la app de Meta para validar la firma de cada webhook entrante.
META_APP_SECRET=""

# ── Archivos subidos (usa un volumen persistente en producción) ───────────────
# Railway: monta un volumen y configura UPLOADS_DIR con su ruta, por ejemplo /data/uploads.
UPLOADS_DIR=""
